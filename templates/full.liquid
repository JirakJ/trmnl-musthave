{% comment %}
TRMNL Must-have – full layout (800x480, 1-bit)
Proměnné: updated, battery_percent (odhad 1–100 nebo nil), weather{ok,temp,feels,hum,wind,label,days[{d,hi,lo,p,label}]},
          kick{ok,live,items[{n,live,v,g,s}]}, twitch{ok,live,items[...]}, countdowns[{n,days,label,d}]
{% endcomment %}
<style>
  .mh, .mh * { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }
  .mh .columns { align-items: flex-start; flex: 1 1 auto; min-height: 0; overflow: hidden; }
  .mh-countdown { display: flex; align-items: center; gap: 18px; width: 100%; min-width: 0; overflow: hidden; flex-shrink: 0; margin-top: auto; border-top: 2px solid #000; padding-top: 3px; }
  .mh-countdown-title { font-size: 11px; font-weight: 700; letter-spacing: .12em; }
  .mh-event { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; flex-shrink: 0; }
  .mh-event-name { font-size: 14px; font-weight: 700; }
  .mh-event-days { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; }
  .mh-event-date { font-size: 11px; color: #555; }
  .mh .column { overflow: hidden; justify-content: flex-start; align-items: stretch; }
  .mh-row { display: flex; align-items: center; gap: 8px; padding: 2px 0; border-bottom: 1px solid #000; min-height: 28px; flex-shrink: 0; }
  .mh-row:last-child { border-bottom: none; }
  .mh-who { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; line-height: 1.15; }
  .mh-name { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-game { font-size: 11px; color: #000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-viewers { flex: 0 0 auto; font-variant-numeric: tabular-nums; min-width: 48px; text-align: right; font-size: 14px; font-weight: 600; }
  .mh-off { min-height: 21px; padding: 1px 0; }
  .mh-off .mh-name { font-weight: 400; font-size: 13px; color: #555; }
  .mh-badge { flex: 0 0 auto; display: inline-block; min-width: 40px; text-align: center; padding: 1px 6px; font-size: 11px; font-weight: 700; letter-spacing: .06em; border: 1.5px solid #000; }
  .mh-badge--live { background: #000; color: #fff; }
  .mh-badge--off { color: #555; border-color: #555; }
  .mh-weather { display: flex; align-items: center; gap: 20px; width: 100%; min-width: 0; }
  .mh-weather-main { flex: 0 0 auto; display: flex; align-items: center; gap: 12px; }
  .mh-weather-main .mh-temp { font-size: 72px; font-weight: 400; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .mh-weather-main .description { font-size: 12px; }
  .mh-days { flex: 1 1 auto; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .mh-day { text-align: center; white-space: nowrap; }
  .mh-day .mh-temps { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.2; }
  .mh-day .description { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-head { display: flex; justify-content: space-between; align-items: baseline; width: 100%; border-bottom: 2px solid #000; padding-bottom: 3px; }
  .mh-head-title { font-size: 13px; font-weight: 700; letter-spacing: .12em; }
  .mh-head-meta { font-size: 13px; font-weight: 500; }
  .mh-head-date { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .mh-battery { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; }
  .mh-battery-icon { position: relative; display: inline-flex; width: 26px; height: 14px; padding: 2px; margin-right: 3px; box-sizing: border-box; border: 2px solid #000; border-radius: 3px; }
  .mh-battery-icon::after { content: ""; position: absolute; right: -5px; top: 2px; width: 3px; height: 6px; background: #000; border-radius: 0 1px 1px 0; }
  .mh-battery-fill { display: block; height: 100%; background: #000; border-radius: 1px; }
  .mh-hours { display: flex; align-items: center; gap: 12px; width: 100%; min-width: 0; flex-shrink: 0; min-height: 22px; border-top: 1px solid #000; padding-top: 3px; }
  .mh-rain { flex: 0 0 160px; font-size: 12px; font-weight: 600; line-height: 1.15; overflow: hidden; max-height: 28px; }
  .mh-hours-grid { flex: 1 1 auto; min-width: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; }
  .mh-hour { display: flex; align-items: center; gap: 4px; min-width: 0; white-space: nowrap; overflow: hidden; font-variant-numeric: tabular-nums; }
  .mh-hour-txt { display: flex; flex-direction: column; min-width: 0; line-height: 1.1; }
  .mh-hour-l1 { font-size: 13px; }
  .mh-hour-l1 b { font-weight: 700; }
  .mh-hour-h { font-size: 11px; }
  .mh-hour-l2 { font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; }
  .mh-hour-bar { position: relative; flex: 0 0 7px; width: 7px; height: 24px; border: 1px solid #000; box-sizing: border-box; }
  .mh-hour-bar span { position: absolute; left: 0; right: 0; bottom: 0; background: #000; }
  .mh-alert { display: flex; align-items: center; gap: 10px; width: 100%; min-width: 0; flex-shrink: 0; min-height: 22px; box-sizing: border-box; border: 2px solid #000; padding: 1px 6px; font-size: 13px; white-space: nowrap; overflow: hidden; }
  .mh-alert--high { background: #000; color: #fff; }
  .mh-alert-tag { flex: 0 0 auto; font-weight: 800; letter-spacing: .04em; font-size: 12px; }
  .mh-alert--high .mh-alert-tag { text-decoration: underline; }
  .mh-alert-event { flex: 0 1 auto; min-width: 0; font-weight: 700; overflow: hidden; text-overflow: ellipsis; }
  .mh-alert-valid { flex: 0 0 auto; font-weight: 600; }
  .mh-alert-more { flex: 0 0 auto; font-size: 12px; border: 1.5px solid currentColor; padding: 0 4px; }
  .mh-alert-src { flex: 0 0 auto; margin-left: auto; font-size: 11px; }
  .mh .columns { align-items: stretch; }
  .mh .column { min-height: 0; }
  /* Řádky, které se nevejdou celé, se zalomí do skrytého dalšího sloupce – žádný useknutý řádek na e-inku. */
  .mh-list { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; flex-wrap: wrap; align-content: flex-start; overflow: hidden; }
  .mh-list > * { width: 100%; flex-shrink: 0; box-sizing: border-box; }
  .mh-col--compact { flex: 0 0 150px !important; width: 150px !important; }
  .mh-weather--compact .mh-weather-main .mh-temp { font-size: 48px; }
  .mh-weather--compact .mh-day .mh-temps { font-size: 16px; }
  .mh-agenda-day { font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 3px 0 1px; border-bottom: 1px solid #000; }
  .mh-agenda-row { display: flex; align-items: center; gap: 8px; padding: 2px 0; min-height: 30px; border-bottom: 1px solid #000; }
  .mh-agenda-row:last-child { border-bottom: none; }
  .mh-agenda-time { flex: 0 0 58px; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; text-align: center; padding: 1px 0; border: 1.5px solid #000; white-space: nowrap; }
  .mh-agenda-time--all { font-size: 11px; padding: 3px 0; }
  .mh-agenda-row--now .mh-agenda-time { background: #000; color: #fff; }
  .mh-pf { flex: 0 0 auto; width: 16px; height: 16px; line-height: 14px; text-align: center; font-size: 11px; font-weight: 800; border: 1.5px solid #000; box-sizing: border-box; }
  .mh-empty { font-size: 14px; font-weight: 600; padding: 6px 0; flex-shrink: 0; }
  .mh-more { font-size: 12px; font-weight: 600; padding: 2px 0; flex-shrink: 0; }
  .mh-offline { font-size: 12px; color: #000; padding: 2px 0; line-height: 1.3; flex-shrink: 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .mh-saving { font-size: 11px; font-weight: 600; border: 1.5px solid #000; padding: 0 4px; margin-left: 2px; white-space: nowrap; }
  .mh-col-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid #000; padding-bottom: 3px; margin-bottom: 2px; }
</style>

<div class="layout layout--col gap--small mh">

  <div class="mh-head">
    <span class="mh-head-title">MUST-HAVE{% if host %} · {{ host }}{% endif %}</span>
    <span class="mh-head-date">
      <span>{{ date }}</span>
      <span class="mh-battery" role="img" aria-label="Baterie: {% if battery_percent != nil %}{{ battery_percent }} procent{% else %}stav není dostupný{% endif %}" title="Poslední hlášený stav baterie (odhad z napětí)">
        <span class="mh-battery-icon" aria-hidden="true"><span class="mh-battery-fill" style="width: {{ battery_percent | default: 0 }}%"></span></span>
        <span aria-hidden="true">{% if battery_percent != nil %}{{ battery_percent }} %{% else %}— %{% endif %}</span>{% if saving %}<span class="mh-saving">{{ saving }}</span>{% endif %}
      </span>
    </span>
    <span class="mh-head-meta">{% if location %}{{ location }} · {% endif %}aktualizováno {{ updated }}{% if fw %} · FW {{ fw }}{% endif %}</span>
  </div>

  {% if alert and alert.hide != true %}
  <div class="mh-alert{% if alert.level >= 3 %} mh-alert--high{% endif %}">
    {% if alert.ok %}
      {% if alert.count > 0 %}
      <span class="mh-alert-tag">VÝSTRAHA · {{ alert.label }}</span>
      <span class="mh-alert-event">{{ alert.event }}</span>
      <span class="mh-alert-valid">{{ alert.valid }}</span>
      {% if alert.count > 1 %}<span class="mh-alert-more">+{{ alert.count | minus: 1 }} další</span>{% endif %}
      {% else %}
      <span class="mh-alert-event">Bez platné výstrahy</span>
      {% endif %}
      <span class="mh-alert-src">{{ alert.src }}{% if alert.sent %} · vydáno {{ alert.sent }}{% endif %}{% if alert.stale %} · data z {{ alert.as_of | default: "dříve" }}{% endif %}</span>
    {% else %}
      <span class="mh-alert-event">Výstrahy {{ alert.src }} nedostupné</span>
    {% endif %}
  </div>
  {% endif %}

  {% if layout.weather != "off" %}
  <div class="mh-weather{% if layout.weather == "compact" %} mh-weather--compact{% endif %}">
    <div class="mh-weather-main">
      {% if weather.ok %}
      <span class="mh-temp">{{ weather.temp | round }}°</span>
      <div class="flex flex--col">
        <span class="title">{{ weather.label }}</span>
        <span class="description">Pocitově {{ weather.feels | round }}° · Vlhkost {{ weather.hum }} % · Vítr {{ weather.wind }} km/h{% if weather.stale %} · data z {{ weather.as_of | default: "dříve" }}{% endif %}</span>
      </div>
      {% else %}
      <span class="mh-temp">—</span>
      <div class="flex flex--col">
        <span class="title">Počasí nedostupné</span>
        <span class="description">Open-Meteo neodpovídá</span>
      </div>
      {% endif %}
    </div>
    <div class="mh-days">
      {% for day in weather.days %}
      <div class="mh-day">
        <span class="label label--small">{{ day.d }}</span>
        <div class="mh-temps">{{ day.hi }}° / {{ day.lo }}°</div>
        <span class="description">{{ day.label }}{% if day.p > 20 %} · {{ day.p }} %{% endif %}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if layout.weather == "full" and weather.hours and weather.hours.size > 0 %}
  <div class="mh-hours">
    <span class="mh-rain">{{ weather.rain }}</span>
    <div class="mh-hours-grid">
      {% for hour in weather.hours %}
      <div class="mh-hour">
        <span class="mh-hour-bar" aria-hidden="true"><span style="height: {{ hour.p | default: 0 }}%"></span></span>
        <span class="mh-hour-txt">
          <span class="mh-hour-l1"><span class="mh-hour-h">{{ hour.h }}h</span> <b>{% if hour.t != nil %}{{ hour.t }}°{% else %}—{% endif %}</b></span>
          <span class="mh-hour-l2">{% if hour.p != nil %}{{ hour.p }} %{% else %}— %{% endif %} · {% if hour.mm != nil %}{{ hour.mm | append: "" | replace: ".", "," }}{% else %}—{% endif %}</span>
        </span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="columns gap--large">
    {% for panel in panels %}
    {% if panel.key == "kick" %}{% assign sec = kick %}{% elsif panel.key == "twitch" %}{% assign sec = twitch %}{% elsif panel.key == "streams" %}{% assign sec = streams %}{% endif %}
    <div class="column{% if panel.compact %} mh-col--compact{% endif %}" style="flex-grow: {{ panel.w }}">
      {% if panel.key == "kick" or panel.key == "twitch" or panel.key == "streams" %}
      <div class="mh-col-head">
        <span class="title title--small">{{ panel.title }}</span>
        <span class="label label--small">{{ sec.live }} live{% if sec.unavailable %} · bez {{ sec.unavailable | join: ", " }}{% endif %}{% if sec.stale %} · data z {{ sec.as_of | default: "dříve" }}{% endif %}</span>
      </div>
      {% if panel.compact %}
        <div class="mh-empty">Nikdo nevysílá</div>
      {% elsif sec.ok %}
        <div class="mh-list">
        {% for item in sec.items %}
        <div class="mh-row {% unless item.live %}mh-off{% endunless %}">
          {% if item.pf %}<span class="mh-pf">{{ item.pf }}</span>{% endif %}
          <div class="mh-who">
            <span class="mh-name">{{ item.n }}{% if item.err %} ?{% endif %}</span>
            {% if item.live %}<span class="mh-game">{% if item.stale %}dříve · {% endif %}{{ item.g | default: "Stream" }}{% if item.s %} · od {{ item.s }}{% endif %}</span>{% endif %}
          </div>
          <span class="mh-viewers">{% if item.live %}{{ item.v }}{% endif %}</span>
          {% if item.live %}<span class="mh-badge mh-badge--live">LIVE</span>{% else %}<span class="mh-badge mh-badge--off">off</span>{% endif %}
        </div>
        {% endfor %}
        {% if sec.items.size == 0 %}<div class="mh-empty">Nikdo nevysílá</div>{% endif %}
        {% if sec.more %}<div class="mh-more">+{{ sec.more }} dalších</div>{% endif %}
        {% if sec.offline %}<div class="mh-offline">offline: {{ sec.offline | join: ", " }}</div>{% endif %}
        </div>
      {% else %}
        <span class="description">{{ panel.na }}</span>
      {% endif %}
      {% endif %}
      {% if panel.key == "agenda" %}
      <div class="mh-col-head">
        <span class="title title--small">{{ panel.title }}</span>
        <span class="label label--small">{% if agenda.partial %}část kalendářů nedostupná{% endif %}{% if agenda.stale %}{% if agenda.partial %} · {% endif %}data z {{ agenda.as_of | default: "dříve" }}{% endif %}</span>
      </div>
      {% if agenda.ok %}
        <div class="mh-list">
        {% if agenda.today_empty %}<div class="mh-empty">Dnes bez událostí</div>{% endif %}
        {% assign lastday = "dnes" %}
        {% for ev in agenda.items %}
        {% if ev.day != lastday %}<div class="mh-agenda-day">{{ ev.day }}</div>{% assign lastday = ev.day %}{% endif %}
        <div class="mh-agenda-row{% if ev.now %} mh-agenda-row--now{% endif %}">
          <span class="mh-agenda-time{% if ev.all %} mh-agenda-time--all{% endif %}">{% if ev.all %}celý den{% elsif ev.now %}TEĎ{% else %}{{ ev.t }}{% endif %}</span>
          <div class="mh-who">
            <span class="mh-name">{{ ev.n }}</span>
            <span class="mh-game">{% if ev.all %}celodenní{% else %}{{ ev.t }}–{{ ev.e }}{% endif %}{% if ev.l %} · {{ ev.l }}{% endif %}</span>
          </div>
        </div>
        {% endfor %}
        {% if agenda.more %}<div class="mh-more">+{{ agenda.more }} dalších</div>{% endif %}
        </div>
      {% else %}
        <span class="description">{{ panel.na }}</span>
      {% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {% if countdowns.size > 0 %}
  <div class="mh-countdown">
    <span class="mh-countdown-title">ODPOČET</span>
    {% for event in countdowns %}
    <span class="mh-event">
      <span class="mh-event-name">{{ event.n }}</span>
      <span class="mh-event-days">{{ event.label }}</span>{% if event.days > 0 %}<span class="mh-event-date">· {{ event.d }}</span>{% endif %}
    </span>
    {% endfor %}
  </div>
  {% endif %}

</div>
