{% comment %} TRMNL Must-have – half vertical (400x480): počasí nahoře, streamy pod sebou {% endcomment %}
<style>
  .mh, .mh * { font-family: "Inter", "Helvetica Neue", Arial, sans-serif; }
  .mh.layout { align-items: stretch; justify-content: flex-start; overflow: hidden; }
  .mh.layout > * { flex-shrink: 0; }
  .mh-weather-main, .mh-forecast, .mh-col-head, .mh-row, .mh-offline { width: 100%; }
  .mh-forecast { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 2px 0 4px; }
  .mh-weather-main { display: flex; align-items: center; gap: 12px; }
  .mh-temp { font-size: 34px; font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
  .mh-col-head { display: flex; justify-content: space-between; border-bottom: 2px solid #000; margin-top: 4px; padding-bottom: 0; }
  .mh-col-head .title { font-size: 14px; }
  .mh-row { display: flex; align-items: center; gap: 6px; padding: 1px 0; border-bottom: 1px solid #000; min-height: 20px; }
  .mh-row:last-child { border-bottom: none; }
  .mh-name { flex: 1 1 auto; min-width: 0; font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-game { flex: 0 1 auto; min-width: 0; font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-viewers { flex: 0 0 auto; min-width: 40px; text-align: right; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .mh-badge { flex: 0 0 auto; padding: 0 5px; font-size: 10px; font-weight: 700; border: 1.5px solid #000; }
  .mh-badge--live { background: #000; color: #fff; }
  .mh-countdown { width: 100%; margin-top: auto; border-top: 2px solid #000; padding-top: 2px; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-countdown b { font-variant-numeric: tabular-nums; }
  .mh-offline { display: block; font-size: 10.5px; color: #555; padding: 1px 0; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
<div class="layout layout--col mh">
  <div class="mh-weather-main">
    <span class="mh-temp">{% if weather.ok %}{{ weather.temp | round }}°{% else %}—{% endif %}</span>
    <div class="flex flex--col">
      <span class="title title--small">{% if weather.ok %}{{ weather.label }}{% else %}Počasí nedostupné{% endif %}</span>
      {% if weather.ok %}<span class="description">Pocitově {{ weather.feels | round }}° · {{ weather.hum }} % · {{ weather.wind }} km/h</span>{% endif %}
    </div>
  </div>
  <div class="mh-forecast description">{% for day in weather.days %}{% unless forloop.first %} · {% endunless %}<b>{{ day.d }}</b> {{ day.hi }}°/{{ day.lo }}° {{ day.label }}{% endfor %}</div>
  <div class="mh-col-head"><span class="title title--small">KICK</span><span class="label label--small">{{ kick.live }} live</span></div>
  {% for item in kick.items %}{% if item.live %}
  <div class="mh-row"><span class="mh-name">{{ item.n }}</span><span class="mh-game">{{ item.g }}</span><span class="mh-viewers">{{ item.v }}</span><span class="mh-badge mh-badge--live">LIVE</span></div>
  {% endif %}{% endfor %}
  <div class="mh-offline">{% assign first = true %}{% for item in kick.items %}{% unless item.live %}{% if first %}offline: {% else %}, {% endif %}{{ item.n }}{% assign first = false %}{% endunless %}{% endfor %}</div>
  <div class="mh-col-head"><span class="title title--small">TWITCH</span><span class="label label--small">{{ twitch.live }} live</span></div>
  {% for item in twitch.items %}{% if item.live %}
  <div class="mh-row"><span class="mh-name">{{ item.n }}</span><span class="mh-game">{{ item.g }}</span><span class="mh-viewers">{{ item.v }}</span><span class="mh-badge mh-badge--live">LIVE</span></div>
  {% endif %}{% endfor %}
  <div class="mh-offline">{% assign first = true %}{% for item in twitch.items %}{% unless item.live %}{% if first %}offline: {% else %}, {% endif %}{{ item.n }}{% assign first = false %}{% endunless %}{% endfor %}</div>
  {% if countdowns.size > 0 %}<div class="mh-countdown">{% for event in countdowns %}{% unless forloop.first %} · {% endunless %}<b>{{ event.n }}</b> {% if event.days == 0 %}DNES{% else %}za {{ event.days }} {% if event.days == 1 %}den{% elsif event.days < 5 %}dny{% else %}dní{% endif %}{% endif %}{% endfor %}</div>{% endif %}
</div>
<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">Must-have</span>
  <span class="instance">{{ updated }}</span>
</div>
